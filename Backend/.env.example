PORT=5000
NODE_ENV=development
# For Render / AWS / Vercel cloud deployments, use Supabase IPv4 Pooler URL format:
# DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recordvault?schema=public

JWT_SECRET=recordvault_jwt_access_secret_key_change_in_prod_32chars!
JWT_REFRESH_SECRET=recordvault_jwt_refresh_secret_key_change_in_prod_32chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# File Storage Configuration (local | s3)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_RECORD=10

# AWS S3 Storage Driver Config (Required if STORAGE_DRIVER=s3)
# If deploying on AWS EC2/ECS/EKS/Lambda with an IAM role, AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY may be omitted.
AWS_REGION=us-east-1
AWS_S3_BUCKET=recordvault-storage-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP Email Delivery (Gmail Config)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="RecordVault <your_email@gmail.com>"

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_MAX=3
OTP_RESEND_WINDOW_MINUTES=15
